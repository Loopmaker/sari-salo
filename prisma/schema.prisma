generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum SyncOperationStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

enum SyncOperationType {
  CREATE_ORDER
  UPDATE_STATUS
}

enum SyncEntityType {
  ORDER
  ORDER_STATUS
}

model Category {
  id        String    @id @default(uuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id         String      @id @default(uuid())
  categoryId String
  category   Category    @relation(fields: [categoryId], references: [id])
  name       String
  price      Decimal     @db.Decimal(10, 2)
  active     Boolean     @default(true)
  imagePath  String?
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Order {
  id               String   @id @default(uuid())
  orderNumber      String
  terminalId       String
  status           OrderStatus @default(NEW)
  total            Decimal  @db.Decimal(10, 2)
  customerName     String?
  clientModifiedAt DateTime
  serverUpdatedAt  DateTime @updatedAt
  createdAt        DateTime @default(now())

  items        OrderItem[]
  statusEvents OrderStatusEvent[]

  @@unique([terminalId, orderNumber])
  @@index([status])
  @@index([createdAt])
}

model DailyOrderCounter {
  date  String @id
  count Int    @default(0)
}

model RateLimitEntry {
  id    String @id
  count Int    @default(1)
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int
  priceAtOrder Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
}

model OrderStatusEvent {
  id               String      @id @default(uuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           OrderStatus
  terminalId       String
  clientModifiedAt DateTime
  createdAt        DateTime    @default(now())

  @@index([orderId, createdAt])
}

model SyncOperation {
  id         String              @id @default(uuid())
  entityType SyncEntityType
  entityId   String
  operation  SyncOperationType
  payload    Json
  status     SyncOperationStatus @default(PENDING)
  attempts   Int                 @default(0)
  lastError  String?
  createdAt  DateTime            @default(now())

  @@index([status, createdAt])
  @@index([entityType, entityId])
}